generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum MaterialKind {
  PDF
  IMAGE
  DOCUMENT
}

enum Visibility {
  ALL
  DEPARTMENTS
}

enum SitePage {
  HOME
  ABOUT
  SERVICES
  CONTACT
}

enum ContentBlockType {
  HERO
  TEXT
  CARD_GRID
  CTA_BAND
  SLIDER
}

enum ArticleCategory {
  GR_CIRCULARS
  LAND_RECORDS
  PANCHAYAT_ADMINISTRATION
  EXAM_PREPARATION
  SALARY_SERVICE_RULES
  FORMS_DOWNLOADS
}

model Department {
  id        String               @id @default(cuid())
  name      String               @unique
  slug      String               @unique
  users     User[]
  materials MaterialDepartment[]
  createdAt DateTime             @default(now())
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  passwordHash         String
  role                 Role                 @default(EMPLOYEE)
  departmentId         String?
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employeeCode         String?              @unique
  designation          String?
  phone                String?
  isActive             Boolean              @default(true)
  mustChangePassword   Boolean              @default(false)
  emailVerified        Boolean              @default(true)
  lastLoginAt          DateTime?
  sessions             Session[]
  resetTokens          PasswordResetToken[]
  emailOtps            EmailOtp[]
  uploads              Material[]           @relation("UploadedBy")
  updatedContentBlocks ContentBlock[]       @relation("ContentBlockUpdatedBy")
  updatedArticles      Article[]            @relation("ArticleUpdatedBy")
  updatedSiteSettings  SiteSettings[]       @relation("SiteSettingsUpdatedBy")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([departmentId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EmailOtp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum LoginAttemptKind {
  LOGIN
  PASSWORD_RESET
  CONTACT_FORM
  REGISTRATION
  EMAIL_OTP_VERIFY
  NEWSLETTER_SUBSCRIBE
}

model LoginAttempt {
  id        String           @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  kind      LoginAttemptKind @default(LOGIN)
  createdAt DateTime         @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.Text
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  materials   Material[]

  @@index([parentId])
}

model ContentBlock {
  id          String           @id @default(cuid())
  page        SitePage
  type        ContentBlockType
  sortOrder   Int
  data        Json
  updatedAt   DateTime         @updatedAt
  updatedById String?
  updatedBy   User?            @relation("ContentBlockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([page, sortOrder])
}

model SiteSettings {
  id                 String   @id @default(cuid())
  contactEmail       String
  contactPhone       String
  contactHours       String
  contactAddress     String
  aboutPhotoKey      String?
  aboutDisclaimer    String   @db.Text
  contactMapImageKey String?
  updatedAt          DateTime @updatedAt
  updatedById        String?
  updatedBy          User?    @relation("SiteSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Material {
  id           String               @id @default(cuid())
  title        String
  description  String?              @db.Text
  kind         MaterialKind
  storageKey   String               @unique // uuid filename on disk, e.g. "9f1c….pdf"
  originalName String
  mimeType     String
  sizeBytes    Int
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  visibility   Visibility           @default(DEPARTMENTS)
  departments  MaterialDepartment[]
  uploadedById String?
  uploadedBy   User?                @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([categoryId])
  @@index([visibility])
}

model MaterialDepartment {
  materialId   String
  departmentId String
  material     Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([materialId, departmentId])
  @@index([departmentId])
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  district  String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Article {
  id          String          @id @default(cuid())
  category    ArticleCategory
  title       String          @db.VarChar(200)
  excerpt     String          @db.VarChar(300)
  body        String          @db.Text
  pdfKey      String?
  pdfLabel    String?
  publishedAt DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  updatedById String?
  updatedBy   User?           @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category, publishedAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // "material.upload", "employee.delete", "auth.login", …
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
